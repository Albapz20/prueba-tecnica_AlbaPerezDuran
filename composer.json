{
    "name": "alba/prueba-tecnica-reservas",
    "description": "Gestión de reservas de alojamiento (PHP nativo + Twig + JS)",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "~10.5"
    },
    "autoload": {
        "psr-4": { "ReservasAlba\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public",
        "test": "phpunit"
    },
    "config": {
        "process-timeout": 0
    }
}