{% extends 'base.twig' %}
{% import '_macros.twig' as ui %}

{% block titulo %}Listado{% endblock %}

{% block contenido %}
    <div class="cabecera-pagina">
        <h1>Reservas</h1>
        <button type="button" id="btn-nueva" class="boton boton-primario">Nueva reserva</button>
    </div>

    {% if error %}
        <p class="aviso aviso-error">{{ error }}</p>
    {% endif %}

    <form id="filtros" class="filtros tarjeta" method="get" action="/">
        <label>Estado
            <select name="estado">
                <option value="">Todos</option>
                {% for e in estados %}
                    <option value="{{ e }}" {{ filtros.estado|default('') == e ? 'selected' }}>{{ e|capitalize }}</option>
                {% endfor %}
            </select>
        </label>
        <label>Desde <input type="date" name="desde" value="{{ filtros.desde|default('') }}"></label>
        <label>Hasta <input type="date" name="hasta" value="{{ filtros.hasta|default('') }}"></label>
        <label>Huésped <input type="search" name="q" value="{{ filtros.q|default('') }}" maxlength="100" placeholder="Nombre..."></label>
        <div class="filtros-acciones">
            <button type="submit" class="boton boton-primario">Filtrar</button>
            <a href="/" id="limpiar" class="boton">Limpiar</a>
        </div>
    </form>

    <p id="total" class="suave">{{ reservas|length }} reserva{{ reservas|length == 1 ? '' : 's' }}</p>

    <div class="tabla-scroll">
        <table id="tabla">
            <thead>
                <tr>
                    <th scope="col">Huésped</th>
                    <th scope="col">Alojamiento</th>
                    <th scope="col">Entrada</th>
                    <th scope="col">Salida</th>
                    <th scope="col" class="num">Importe</th>
                    <th scope="col">Estado</th>
                    <th scope="col"><span class="solo-lectores">Acciones</span></th>
                </tr>
            </thead>
            <tbody id="tabla-cuerpo">
                {% for r in reservas %}
                    <tr>
                        <td>{{ r.nombre_huesped }}</td>
                        <td>{{ r.nombre_alojamiento }}</td>
                        <td>{{ r.fecha_entrada|date('d/m/Y') }}</td>
                        <td>{{ r.fecha_salida|date('d/m/Y') }}</td>
                        <td class="num">{{ r.importe|number_format(2, ',', '.') }} €</td>
                        <td>{{ ui.estado(r.estado) }}</td>
                        <td class="acciones">
                            <a href="/reservas/{{ r.id }}">Ver</a>
                            {% if r.estado == 'pendiente' %}
                                <button type="button" class="boton boton-pequeno" data-accion="confirmada" data-id="{{ r.id }}">Confirmar</button>
                            {% endif %}
                            {% if r.estado != 'cancelada' %}
                                <button type="button" class="boton boton-pequeno boton-peligro" data-accion="cancelada" data-id="{{ r.id }}">Cancelar</button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="suave">No hay reservas que coincidan con los filtros.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <dialog id="dialogo-nueva" aria-labelledby="titulo-dialogo">
        <form id="form-nueva" novalidate>
            <h2 id="titulo-dialogo">Nueva reserva</h2>

            <label>Nombre del huésped
                <input name="nombre_huesped" required maxlength="150" autocomplete="off">
                <span class="error-campo" data-error-de="nombre_huesped"></span>
            </label>
            <label>Email del huésped
                <input name="email_huesped" type="email" required maxlength="150">
                <span class="error-campo" data-error-de="email_huesped"></span>
            </label>
            <label>Alojamiento
                <input name="nombre_alojamiento" required maxlength="150">
                <span class="error-campo" data-error-de="nombre_alojamiento"></span>
            </label>
            <div class="fila-doble">
                <label>Entrada
                    <input name="fecha_entrada" type="date" required>
                    <span class="error-campo" data-error-de="fecha_entrada"></span>
                </label>
                <label>Salida
                    <input name="fecha_salida" type="date" required>
                    <span class="error-campo" data-error-de="fecha_salida"></span>
                </label>
            </div>
            <label>Importe (€)
                <input name="importe" type="number" min="0" step="0.01" inputmode="decimal" required>
                <span class="error-campo" data-error-de="importe"></span>
            </label>
            <label>Notas
                <textarea name="notas" rows="3" maxlength="1000"></textarea>
                <span class="error-campo" data-error-de="notas"></span>
            </label>

            <div class="dialogo-acciones">
                <button type="button" id="btn-cerrar-dialogo" class="boton">Cerrar</button>
                <button type="submit" class="boton boton-primario">Crear reserva</button>
            </div>
        </form>
    </dialog>
{% endblock %}